# Copy this file to qwen38.env and edit as needed.
# qwen38.env is gitignored — it's your local, possibly-secret-bearing config.
#
# Every default below is chosen to mitigate a specific, currently-open
# upstream llama.cpp bug on gfx1151 (Strix Halo). See README.md "Known
# upstream bugs" table and docs/TROUBLESHOOTING.md before changing them.

# --- Paths ---
LLAMA_CPP_DIR="vendor/llama.cpp"
MODEL_DIR="models"
LOG_DIR="logs"
SECRETS_DIR=".secrets"

# --- ROCm ---
# Leave unset to use the system default (/opt/rocm). Set this if you installed
# a TheRock nightly tarball to a side-by-side prefix instead (see README §2b).
#ROCM_PATH="/home/zebra/rocm-therock-nightly"
GPU_TARGET="gfx1151"

# --- Model source ---
#
# Laguna S 2.1 (Poolside, July 2026) adopted 2026-09-19, replacing
# Qwen3.8-27B as the default. Reason: Qwen3.8's hybrid Gated-DeltaNet
# architecture is the root cause of most of this repo's known-bugs table
# (llama.cpp#20354, #27623, #28211) — the whole current Qwen line
# (3.5→3.8, including the Qwen4 preview) has doubled down on that same
# architecture family, so a newer Qwen wouldn't help. Laguna S 2.1 uses
# only conventional GQA + sliding-window attention — confirmed by reading
# its `laguna.cpp` in our own llama.cpp checkout: built entirely from the
# same shared `build_attn`/`build_moe_ffn` helpers dozens of other
# well-supported models use, no novel custom op like Gated-DeltaNet
# needed. Measured directly on this exact box: sustained ~26 tok/s with
# NO speculative decoding at all — already faster than Qwen3.8-27B's best
# result, which needed MTP speculative decoding to reach 14-23 tok/s.
#
# 118B total / 8B active MoE. Ships as 3 GGUF shards — MODEL_FILE is the
# first (llama.cpp auto-detects the siblings by naming convention at load
# time), MODEL_FILE_EXTRA_SHARDS lists the rest for `download` to fetch.
# No mmproj (not multimodal) — MMPROJ_FILE intentionally left unset.
# Sizes confirmed via HEAD request against the real files, not estimated.
MODEL_REPO="unsloth/Laguna-S-2.1-GGUF"
MODEL_FILE="UD-Q4_K_M/Laguna-S-2.1-UD-Q4_K_M-00001-of-00003.gguf"
MODEL_FILE_EXTRA_SHARDS="UD-Q4_K_M/Laguna-S-2.1-UD-Q4_K_M-00002-of-00003.gguf,UD-Q4_K_M/Laguna-S-2.1-UD-Q4_K_M-00003-of-00003.gguf"
MODEL_FILE_EXPECT_BYTES=3683648          # first shard only — tiny, mostly metadata; other two are ~49.9GB + ~23.2GB
MMPROJ_FILE=""

# DFlash speculative decoding (Poolside's own draft-model mechanism, ~2x+
# claimed speedup) was tried and deliberately NOT adopted: reproducibly
# hangs during draft-model memory measurement on Poolside's llama.cpp
# fork (branch `laguna`) in this exact config — "dflash requires
# ctx_other to be set" followed by a hang, not a clean failure. A real
# bug in that fork, not a flag/config issue on our end (tested with and
# without -fa). SPEC_TYPE is empty below — Laguna has no MTP-style
# "nextn" draft head like Qwen, and DFlash needs the broken fork, so
# there is currently no working speculative-decoding path for this model.
SPEC_TYPE=""

# --- Previous model (Qwen3.8-27B) — kept as a documented, working
# fallback. Uncomment this whole block AND set SPEC_TYPE=draft-mtp AND
# clear MODEL_FILE_EXTRA_SHARDS AND restore MMPROJ_FILE AND set
# UBATCH_SIZE/BATCH_SIZE back to 8192 (see that section below — Laguna's
# smaller 2048 does NOT carry the same #28211 silent-corruption
# protection for Qwen) to roll back; see README "Rolling back to
# Qwen3.8-27B".
#MODEL_REPO="bartowski/Qwen3.8-27B-GGUF"
#MODEL_FILE="Qwen3.8-27B-Q5_K_M.gguf"
#MMPROJ_FILE="mmproj-Qwen3.8-27B-bf16.gguf"
#MODEL_FILE_EXPECT_BYTES=20923877088     # ~20.9GB, confirmed via HEAD request
#MMPROJ_FILE_EXPECT_BYTES=931145952      # ~931MB, sanity check only, not exact
#MODEL_FILE_EXTRA_SHARDS=""
#SPEC_TYPE="draft-mtp"
#
# Even older default (Q8_0) — see README for full quant history.
#MODEL_FILE="Qwen3.8-27B-Q8_0.gguf"
#MODEL_FILE_EXPECT_BYTES=29116388960

#MODEL_REPO="unsloth/Qwen3.8-27B-GGUF"
#MODEL_FILE="Qwen3.8-27B-UD-Q8_K_XL.gguf"
#MMPROJ_FILE="mmproj-F16.gguf"

# --- Quantization benchmarking (`bench` subcommand) ---
# Tests candidate quants against whatever MODEL_FILE is currently
# configured (the baseline), using the exact same server flags production
# uses (including MTP speculative decoding) — see README "Benchmarking
# alternate quants" for the full methodology.
#
# FP8/BF8 is deliberately NOT an option here: gfx1151 (RDNA3.5) has no
# native FP8/BF8 matrix-core acceleration (that's CDNA3/CDNA4/RDNA4 only,
# confirmed via AMD's own ROCm precision-support docs), llama.cpp has no
# mainline GGUF FP8 quant type to load even if it did (PR #10055 unmerged
# since Dec 2024), and even hypothetically both existed, FP8 and Q8_0 are
# both ~8 bits/weight so there'd be no memory-bandwidth win either. A
# smaller integer k-quant is the only real lever on this hardware.
#
# BENCH_ALLOWED_QUANTS is a hard allowlist, not just a recommendation —
# `bench` refuses (does not warn) anything outside it. Q4_K_M and below are
# deliberately excluded: a community report on similar hardware (same MTP
# speculative-decoding approach) found Q4 got net SLOWER, not faster,
# because the smaller/noisier quant's outputs diverged too far from what
# the MTP draft head expects ("draft-acceptance collapse") — not
# independently reproduced on this exact box, but the risk is specific to
# our production config (speculative decoding on), so treat it as a real
# constraint until proven otherwise, not a guess to test past.
BENCH_QUANTS="Q6_K,Q5_K_M"
BENCH_ALLOWED_QUANTS="Q8_0,Q6_K,Q6_K_L,Q5_K_M,Q5_K_L,Q5_1,Q5_0"

# Real byte sizes confirmed via HEAD request against bartowski's repo
# (2026-09-18) — do not guess these for a different quant/repo, confirm
# first (e.g. `curl -sIL <resolve-url> | grep -i content-length`).
BENCH_Q6_K_EXPECT_BYTES=23860565728
BENCH_Q5_K_M_EXPECT_BYTES=20923877088

BENCH_GEN_TOKENS="512"          # generated tokens per request — enough for a stable tok/s reading
BENCH_REPEATS="3"               # per (quant, prompt) pair; median reported, absorbs one-off noise
BENCH_LONG_PROMPT_MIN_CHARS="80000"   # matches real measured qwen-code prompt sizes on this setup

# Decision-rule thresholds — see README "Adopting a bench result". Named
# constants rather than magic numbers, so they're easy to revisit later.
BENCH_MIN_SPEEDUP_PCT="10"          # candidate must beat baseline long-context gen tok/s by at least this %
BENCH_MAX_ACCEPTANCE_DROP_PP="5"    # candidate's MTP draft-accept ratio must not fall more than this many percentage points vs baseline

SERVED_MODEL_NAME="laguna-s-2.1"

# --- Server ---
HOST="0.0.0.0"
PORT="8000"

# SERVER_HOST: the address a CLIENT uses to reach this server — different
# from HOST above (the bind address). Leave as 127.0.0.1 on the machine
# that actually runs `build`/`serve`. On a client-only machine (e.g. a
# laptop that only runs `wire-qwen-code`, cloned from this same repo),
# set this to the server machine's LAN IP or hostname instead.
SERVER_HOST="127.0.0.1"

# CTX_SIZE: History: started at 32768 (too tight for real qwen-code
# sessions — hit 34163 tokens), raised to 65536 (still hit — 69081
# tokens), raised to 73728 specifically to stay under llama.cpp#27623's
# reported ~25x decode collapse past ~80K KV position on this hybrid
# Gated-DeltaNet architecture.
#
# Raised again to 131072 on 2026-09-18 after directly retesting #27623 on
# THIS exact build/quant/config: sent a real ~97,176-token prompt (well
# past the reported ~80K collapse point) and measured sustained decode at
# ~12-15 tok/s over two requests (53 and 400 generated tokens) — no
# collapse, output coherent. GPU memory checked too: ~39GB of the 47GB GTT
# pool used with a 140032-token ctx-size allocated, comfortable headroom.
# #27623 is NOT reproduced on this box as tested, but it remains open
# upstream (other hardware/quants/platforms), this was one test scenario
# (one prompt shape, Q5_K_M, MTP on), and nothing above ~97K has actually
# been verified — 131072 leaves real margin below both that tested point
# and the model's 262144 native ceiling, not a claim that everything up to
# 262144 is safe. Re-verify after any `update` picks up a new llama.cpp
# build; the script warns (does not block) above 163840.
#
# CLIENT_CTX_SIZE/QWEN_SESSION_TOKEN_LIMIT below are scaled up
# proportionally to preserve the same layered-defense ratios established
# when this was 73728 (soft compaction trigger, then a hard backstop, both
# comfortably below the real server limit).
#
# NOTE: the history above is about Qwen3.8-27B specifically (#27623 is a
# Qwen-hybrid-architecture bug that doesn't apply to Laguna S 2.1 at all).
# 131072 was independently re-verified for Laguna directly on this box
# 2026-09-19: loads and serves correctly at this context, ~76GB/80GB GTT
# used (~5.7GB headroom) — a real but not huge safety margin. Laguna's
# native context is 1,048,576, far beyond what's been tested; treat
# anything above 131072 as unverified for this model too.
CTX_SIZE="131072"

# CLIENT_CTX_SIZE: what we tell qwen-code via generationConfig.
# contextWindowSize — deliberately LOWER than CTX_SIZE, not equal to it.
# qwen-code's token counts are estimates (its own debug log marks them
# `estimated=true`), and a single large step (e.g. one big tool result) can
# jump past its compaction trigger before compaction runs. Confirmed by
# hand: reporting the exact CTX_SIZE (65536 at the time) still overshot to
# 68046 tokens and hard-failed. Keep this comfortably below CTX_SIZE —
# the gap is the safety margin. NOTE: even a 16K-token margin was fully
# blown through in one turn (see QWEN_TOOL_OUTPUT_THRESHOLD below for the
# fix that actually addresses the root cause, not just this symptom).
CLIENT_CTX_SIZE="98304"

# QWEN_TOOL_OUTPUT_THRESHOLD / QWEN_TOOL_OUTPUT_LINES / QWEN_SESSION_TOKEN_LIMIT:
# written into qwen-code's global settings.json (tools.truncateToolOutputThreshold/
# Lines, model.sessionTokenLimit) by wire-qwen-code. Confirmed by hand: the
# CLIENT_CTX_SIZE margin above got fully consumed in a single turn because
# qwen-code's stock per-call tool-output truncation (25000 chars) still lets
# a *batch* of several fanned-out tool calls add up to far more than that.
# Lowering the per-call cap bounds how much a single turn can add; sessionTokenLimit
# is a deterministic backstop that blocks sending the next message outright
# once the recorded prompt is already over budget, independent of qwen-code's
# (unreliable) token-count estimation. Requires a fresh `qwen` session to
# take effect, not just a retry.
QWEN_TOOL_OUTPUT_THRESHOLD="8000"
QWEN_TOOL_OUTPUT_LINES="300"
QWEN_SESSION_TOKEN_LIMIT="114688"

# QWEN_CODE_MAX_OUTPUT_TOKENS: caps a single turn's generated tokens.
# Without this, qwen-code defaults to the model's *declared* output limit —
# effectively unbounded here. Confirmed by hand: a real turn generated
# 12,000+ tokens at a healthy, stable ~13.5 tok/s (server logs show no
# stall/corruption) and was still going when qwen-code's own 15-minute
# stream-lifetime cap (QWEN_STREAM_MAX_LIFETIME_MS, default 900000ms)
# killed the connection — discarding the entire in-flight response instead
# of truncating cleanly. 10000 / ~13.5 tok/s (low end of measured range)
# ≈ 12.3 min, comfortable margin under 15 min; hitting it gives a clean
# `finish_reason: length` you can just ask to continue from.
QWEN_CODE_MAX_OUTPUT_TOKENS="10000"

# UBATCH_SIZE / BATCH_SIZE:
#
# 2048 for Laguna S 2.1 (current default) — this model does NOT need the
# large value below. Verified directly by hand 2026-09-19: a needle-in-
# haystack test with a 4088-token prompt (well past 2048) correctly
# retrieved an exact marker string with ubatch=2048, no corruption. Using
# a smaller ubatch matters here specifically because compute-buffer
# memory scales with ubatch size roughly independent of context length —
# confirmed by hand: CTX_SIZE=131072 at ubatch=8192 used 81.4GB/82GB GTT
# (446MB free — dangerously tight), while the SAME context at ubatch=2048
# used only 77.2GB (4.7GB free). Full context AND safe headroom, simply
# by not carrying over a Qwen-specific value that doesn't apply here.
#
# 8192 was for Qwen3.8-27B specifically: mitigates llama.cpp#28211
# (prompts longer than n_ubatch get SILENTLY WRONG logits on HIP/gfx1151
# — no crash, just bad output — for THAT model's architecture). Raised
# well above the llama.cpp stock default of 512 to push the
# silently-broken-output boundary past the overwhelming majority of real
# chat/tool-calling prompts; does not fix the upstream bug, still open.
# **If rolling back to Qwen3.8-27B, you MUST also set this back to 8192**
# — Laguna's smaller value does not carry the same protection for Qwen's
# architecture, and #28211 is a silent-corruption bug, not a crash, so a
# forgotten rollback here would fail quietly.
#
# Keep BATCH_SIZE == UBATCH_SIZE so there's no second, smaller, invisible
# chunk boundary below whichever ceiling is actually in effect.
UBATCH_SIZE="2048"
BATCH_SIZE="2048"

# PARALLEL: mitigates lemonade-sdk#3160 (progressive generation corruption
# under concurrent/sustained load on ROCm-nightly gfx1151, recovers only on
# full reload). Single-slot serving is the safe default. If you raise this,
# strongly consider `./serve-qwen38.sh install-watchdog`.
PARALLEL="1"

GPU_LAYERS="999"        # full offload — unified memory, no VRAM ceiling
FLASH_ATTN="auto"       # GGML_HIP_ROCWMMA_FATTN is compiled OFF (see build
                         # flags in serve-qwen38.sh) due to llama.cpp#24437,
                         # so "auto" picks a safe generic kernel per layer.

# SPEC_TYPE / SPEC_DRAFT_N_MAX: speculative decoding. SPEC_TYPE itself is
# set once, up in the "Model source" section above (currently "" — no
# working speculative-decoding path for the current default, Laguna S
# 2.1; see that section for why). SPEC_DRAFT_N_MAX only matters when
# SPEC_TYPE is non-empty. Left here for when Qwen3.8-27B's MTP mode
# applies (draft-mtp, using the model's own "nextn" tensors as a draft
# head, no separate draft model needed — confirmed by hand: went from
# ~7.4 to ~14-20 tok/s, roughly 1.9-2.7x, on that model/quant/hardware).
SPEC_DRAFT_N_MAX="4"

# --- Security ---
# Auto-generated on first `init` if this file is left blank; stored in
# .secrets/api_key (chmod 600) and reused across runs.
API_KEY=""

# --- qwen-code CLI wiring ---
# "user" -> ~/.qwen/.env   "project" -> $QWEN_PROJECT_DIR/.qwen/.env
QWEN_ENV_TARGET="user"
QWEN_PROJECT_DIR=""
